# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA commite o .env (ele está no .gitignore).

# Connection string do Postgres do Supabase.
# Em produção (Render/Railway), use a Transaction Pooler (porta 6543),
# NAO a direct connection (5432) — a direct e IPv6-only nos planos
# gratuitos do Supabase, e o Render free so sai por IPv4.
# Pegue em: Supabase Dashboard > Project Settings > Database >
#           Connection string > Transaction pooler
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<SENHA>@aws-0-<REGIAO>.pooler.supabase.com:6543/postgres

# URL do projeto Supabase (Project Settings > API > Project URL)
SUPABASE_URL=https://<PROJECT_REF>.supabase.co

# Anon key publica do Supabase (Project Settings > API > anon public).
# Usada pelo frontend; o backend so precisa dela pra referencia.
# NAO e secret — pode aparecer no bundle do frontend.
SUPABASE_ANON_KEY=sb_publishable_...

# Endpoint JWKS pra validacao ES256 dos JWTs do Supabase Auth.
# Formato: https://<PROJECT_REF>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=https://<PROJECT_REF>.supabase.co/auth/v1/.well-known/jwks.json
